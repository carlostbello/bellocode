# SwiftPM and build output (build/ includes snapshots, release zips and verify reports)
.build/
.swiftpm/
build/
DerivedData/
*.xcodeproj/
xcuserdata/

# Vendored binaries fetched by Scripts/fetch-opencode.sh
Vendor/

# Plugin dependencies, if bun or npm is ever run in Plugin/
node_modules/

# Logs, local databases and crash output
*.log
logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.crash

# Credentials and local environment files: never commit these
.env
.env.*
*.pem
*.p12
*.key

# Editors and macOS
.vscode/
.idea/
.DS_Store
*.swp
