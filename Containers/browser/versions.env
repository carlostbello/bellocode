# Pinned inputs of the shared browser image (docs/features/shared-browser.md "Image and pinning").
# Changing any line changes the image's input hash, so BelloCode rebuilds it; `make browser-verify` is the gate.
# Base: Debian 12 (bookworm) slim, digest-pinned. Docker Hub pulls time out inside this Rancher VM (G7), so the base is
# the locally cached node:22-bookworm-slim (Debian bookworm + Node in /usr/local); the final stage is flattened from it
# with Node removed, so no Node reaches the image.
BASE_IMAGE=node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
# Debian's security-maintained Chromium (arm64), exact version and .deb SHA-256 (apt also checks the signed index).
CHROMIUM_VERSION=156.0.8078.79-1~deb12u1
CHROMIUM_SHA256=ef74b82730d487ef3b3232e6e5c20793ddc7174e3e9d240b58032584c2749adf
CHROMIUM_COMMON_SHA256=853af7690a8ea35a73911c7bf816fe032888099ebb3d6c9ba98e2b94668fa44f
CHROMIUM_SANDBOX_SHA256=0bed7fc607e3fdd94963916502f91324eac161566b4379621e04df27d204ae1a
# noVNC's static client only (the Debian package depends on nodejs; its files are extracted, never installed).
NOVNC_VERSION=1:1.3.0-1
NOVNC_SHA256=5ff8b8c93c1c6cc911e01bfa77d12d4098e1904f738a996040c8095e02492ebb
# browse (github.com/anomalyco/browse) v0.1.5: Rust binary from the npm platform tarball, and the extension release zip.
BROWSE_VERSION=0.1.5
BROWSE_TGZ_SHA256=0b550e8b6623994a947bc998704b4bc5e796e307323de5f947cd4abd7c7d7dab
BROWSE_EXT_SHA256=5527b8e2865068ebd4060c6274ce7633bc06e1d2080fd19974a1cf9c7a7fe18d
# Revision of the reviewed seccomp delta (seccomp-chromium.json = Docker's default + clone/unshare/setns/chroot).
SECCOMP_REVISION=g7-1
